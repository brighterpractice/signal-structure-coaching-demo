---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
  organizationSchema,
  websiteSchema,
  pageSchema,
} from '../lib/schema';
---

<Layout
  title="ADHD & Executive Function Coaching"
  description="Practical ADHD and executive-function coaching for adults, college students, and professionals who want better systems for planning, focus, and follow-through."
  schema={pageSchema([organizationSchema(), websiteSchema()])}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-code" aria-hidden="true">
        <span>SIGNAL / STRUCTURE</span>
        <strong>01</strong>
      </div>

      <div class="hero-copy">
        <p class="eyebrow">ADHD & executive-function coaching</p>
        <h1>
          Build systems that work with your brain.
          <span>Not against it.</span>
        </h1>

        <p class="lead">
          Signal & Structure helps adults, college students, and professionals
          turn scattered demands into visible plans, practical systems, and
          next steps that are easier to follow through on.
        </p>

        <div class="hero-actions">
          <Button href={appointmentUrl} tracking="request-appointment">
            Book a discovery call
          </Button>

          <a href="/how-coaching-works/">See how coaching works →</a>
        </div>
      </div>

      <div class="hero-map" aria-hidden="true">
        <div class="map-axis axis-x"></div>
        <div class="map-axis axis-y"></div>
        <span class="point point-one"></span>
        <span class="point point-two"></span>
        <span class="point point-three"></span>
        <p>capture</p>
        <p>structure</p>
        <p>follow through</p>
      </div>
    </div>
  </section>

  <section class="signal-section">
    <div class="container signal-layout">
      <div class="signal-intro">
        <p class="eyebrow">Start with the friction</p>
        <h2>Knowing what to do is not always the problem.</h2>
        <p>
          The hard part may be starting, remembering, prioritizing, estimating
          time, switching tasks, or keeping a useful system going once the
          initial motivation wears off.
        </p>
      </div>

      <div class="signal-list">
        {
          homepageServices.map((service, index) => (
            <a href={service.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
              </div>
              <b aria-hidden="true">↗</b>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <div class="process-heading">
        <p class="eyebrow">A practical coaching loop</p>
        <h2>Make the problem visible. Build something you can actually use.</h2>
        <p>
          Coaching is not about finding one perfect planner or forcing yourself
          into somebody else's routine. We look at what is happening in real
          life, build a workable support, and adjust it based on what happens.
        </p>
      </div>

      <ol class="process-grid">
        <li>
          <span>01</span>
          <h3>Notice</h3>
          <p>
            Identify where the task, routine, deadline, or decision actually
            starts breaking down.
          </p>
        </li>

        <li>
          <span>02</span>
          <h3>Design</h3>
          <p>
            Create a visible system that reduces friction and makes the next
            useful action easier to find.
          </p>
        </li>

        <li>
          <span>03</span>
          <h3>Adjust</h3>
          <p>
            Test it in real life, keep what helps, and change what does not
            survive an ordinary week.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="methods">
    <div class="container methods-grid">
      <div class="methods-copy">
        <p class="eyebrow">Systems, not hacks</p>
        <h2>Build support outside your head.</h2>
        <p>
          Useful structure reduces how much you have to remember, re-decide,
          or mentally hold at once. The goal is not perfect productivity. It is
          a system that makes important things easier to see and act on.
        </p>

        <a href="/how-coaching-works/">See how coaching works →</a>
      </div>

      <div class="method-list">
        <a href="/how-coaching-works/">
          <span>01</span>
          <strong>Capture what matters</strong>
          <small>Move tasks, ideas, and commitments out of working memory</small>
        </a>

        <a href="/how-coaching-works/">
          <span>02</span>
          <strong>Make priorities visible</strong>
          <small>Separate what matters now from everything competing for attention</small>
        </a>

        <a href="/how-coaching-works/">
          <span>03</span>
          <strong>Make time easier to see</strong>
          <small>Plan around real capacity instead of an idealized day</small>
        </a>

        <a href="/how-coaching-works/">
          <span>04</span>
          <strong>Build for recovery</strong>
          <small>Create systems that can restart after an interrupted week</small>
        </a>
      </div>
    </div>
  </section>

  <section class="coach">
    <div class="container coach-grid">
      <div class="coach-identity">
        <div class="portrait" aria-hidden="true">
          <span></span>
        </div>
        <p>Avery Reed</p>
        <small>ADHD & Executive Function Coach</small>
      </div>

      <div class="coach-copy">
        <p class="eyebrow">Practical, collaborative coaching</p>
        <h2>Less judgment. More useful information.</h2>
        <p>
          Avery's coaching style is curious, direct, and systems-focused.
          Instead of treating a difficult week as proof that you failed the
          plan, it becomes information about what the plan needs to do better.
        </p>

        <a href="/about/">About Signal & Structure →</a>
      </div>
    </div>
  </section>

  <section class="facts">
    <div class="container">
      <p class="eyebrow">Coaching snapshot</p>
      <dl>
        <div><dt>Format</dt><dd>Individual virtual coaching</dd></div>
        <div><dt>Clients</dt><dd>Adults, college students & professionals</dd></div>
        <div><dt>Location</dt><dd>Minneapolis-based, virtual coaching</dd></div>
        <div><dt>Starting point</dt><dd>A discovery call</dd></div>
      </dl>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-grid">
      <div>
        <p class="eyebrow">Start with what feels stuck</p>
        <h2>You do not need a better explanation before reaching out.</h2>
      </div>

      <div>
        <p>
          A discovery call is a simple place to talk about what is difficult
          right now, what you have already tried, and whether coaching feels
          like a useful next step.
        </p>

        <Button
          href={appointmentUrl}
          variant="light"
          tracking="request-appointment"
        >
          Book a discovery call
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero,
  .signal-section,
  .process,
  .methods,
  .coach,
  .facts,
  .cta {
    padding: clamp(4rem,8vw,7rem) 0;
  }

  .hero {
    overflow: hidden;
    background:
      linear-gradient(120deg,#f8fbff 0%,#e8f1fb 100%);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }

  .hero-code {
    display: flex;
    align-items: start;
    justify-content: space-between;
    padding-top: .75rem;
    border-top: 3px solid #5f82ad;
    color: #5f82ad;
  }

  .hero-code span {
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .hero-code strong {
    font-size: 2.5rem;
    line-height: 1;
  }

  .hero-copy h1 {
    max-width: 13ch;
    font-size: clamp(3.15rem,7vw,6.5rem);
    line-height: .96;
  }

  .hero-copy h1 span {
    display: block;
    color: #5f82ad;
  }

  .lead {
    max-width: 43rem;
    margin-top: 1.6rem;
    font-size: clamp(1.08rem,1.7vw,1.3rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 2rem;
  }

  .hero-actions > a:not(.button),
  .methods-copy a,
  .coach-copy a {
    color: #3f648d;
    font-weight: 750;
    text-decoration: none;
  }

  .hero-map {
    position: relative;
    min-height: 21rem;
    border: 1px solid #bacde2;
    background:
      linear-gradient(rgba(95,130,173,.1) 1px,transparent 1px),
      linear-gradient(90deg,rgba(95,130,173,.1) 1px,transparent 1px);
    background-size: 2.5rem 2.5rem;
  }

  .map-axis {
    position: absolute;
    background: #7899bd;
  }

  .axis-x {
    top: 50%;
    left: 8%;
    right: 8%;
    height: 2px;
  }

  .axis-y {
    top: 8%;
    bottom: 8%;
    left: 50%;
    width: 2px;
  }

  .point {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 3px solid white;
    border-radius: 50%;
    background: #3f648d;
    box-shadow: 0 0 0 1px #3f648d;
  }

  .point-one { left: 18%; top: 61%; }
  .point-two { left: 47%; top: 37%; }
  .point-three { right: 16%; top: 20%; }

  .hero-map p {
    position: absolute;
    margin: 0;
    color: #496b91;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .hero-map p:nth-of-type(1) { left: 8%; bottom: 10%; }
  .hero-map p:nth-of-type(2) { left: 43%; top: 22%; }
  .hero-map p:nth-of-type(3) { right: 7%; top: 7%; }

  .signal-section {
    background: white;
  }

  .signal-layout,
  .methods-grid,
  .coach-grid,
  .cta-grid {
    display: grid;
    gap: 3rem;
  }

  .signal-intro {
    max-width: 32rem;
  }

  .signal-list {
    display: grid;
    border-top: 1px solid var(--sand);
  }

  .signal-list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--sand);
    color: var(--body);
    text-decoration: none;
    transition: padding .18s ease,background .18s ease;
  }

  .signal-list a:hover {
    padding-inline: 1rem;
    background: #edf4fb;
  }

  .signal-list span {
    color: #5f82ad;
    font-size: .7rem;
    font-weight: 800;
  }

  .signal-list h3 {
    margin-bottom: .25rem;
  }

  .signal-list p {
    font-size: .92rem;
  }

  .signal-list b {
    color: #3f648d;
  }

  .process {
    background: #edf4fb;
  }

  .process-heading {
    max-width: 48rem;
  }

  .process-grid {
    display: grid;
    gap: 1px;
    margin: 3rem 0 0;
    padding: 1px;
    background: #bfcfe0;
    list-style: none;
  }

  .process-grid li {
    padding: 1.5rem;
    background: #f8fbff;
  }

  .process-grid span,
  .method-list span {
    color: #5f82ad;
    font-size: .7rem;
    font-weight: 800;
  }

  .process-grid h3 {
    margin-top: 2.5rem;
  }

  .methods {
    background: #0b1d3a;
    color: #dbe7f3;
  }

  .methods h2 {
    color: white;
  }

  .methods .eyebrow {
    color: #b5c8df;
  }

  .methods-copy a {
    display: inline-block;
    margin-top: 1rem;
    color: white;
  }

  .method-list {
    display: grid;
    border-top: 1px solid rgba(255,255,255,.2);
  }

  .method-list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: .25rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255,255,255,.2);
    color: white;
    text-decoration: none;
  }

  .method-list strong {
    font-size: .95rem;
  }

  .method-list small {
    grid-column: 2;
    color: #aebed0;
  }

  .coach {
    background: white;
  }

  .coach-identity {
    align-self: start;
  }

  .portrait {
    position: relative;
    width: min(100%,24rem);
    aspect-ratio: 4/5;
    overflow: hidden;
    background:
      linear-gradient(145deg,#dce9f7,#7793b3);
  }

  .portrait:before {
    content: "";
    position: absolute;
    width: 30%;
    aspect-ratio: 1;
    left: 35%;
    top: 22%;
    border-radius: 50%;
    background: #3f648d;
  }

  .portrait span {
    position: absolute;
    width: 68%;
    height: 48%;
    left: 16%;
    bottom: -4%;
    border-radius: 48% 48% 0 0;
    background: #a9bed6;
  }

  .coach-identity > p {
    margin: 1rem 0 0;
    color: var(--ink);
    font-weight: 800;
  }

  .coach-identity small {
    color: var(--muted);
  }

  .coach-copy {
    align-self: center;
    max-width: 47rem;
  }

  .facts {
    background: #edf4fb;
  }

  .facts dl {
    display: grid;
    gap: 1px;
    margin: 2rem 0 0;
    background: #bfcfe0;
  }

  .facts dl div {
    padding: 1.25rem;
    background: #f8fbff;
  }

  .facts dt {
    color: #5f82ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: .45rem 0 0;
    color: var(--ink);
    font-weight: 750;
  }

  .cta {
    background: #294c70;
    color: #dbe7f3;
  }

  .cta h2 {
    color: white;
  }

  .cta .eyebrow {
    color: #bfd0e3;
  }

  .cta .button {
    margin-top: 1rem;
  }

  @media (min-width:48rem) {
    .hero-grid {
      grid-template-columns: 8rem minmax(0,1fr);
      gap: clamp(3rem,6vw,6rem);
    }

    .hero-map {
      grid-column: 2;
    }

    .signal-layout,
    .methods-grid,
    .coach-grid,
    .cta-grid {
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(3rem,7vw,7rem);
    }

    .process-grid {
      grid-template-columns: repeat(3,1fr);
    }

    .facts dl {
      grid-template-columns: repeat(4,1fr);
    }
  }

  @media (min-width:75rem) {
    .hero-grid {
      grid-template-columns: 8rem minmax(0,1fr) minmax(20rem,.75fr);
      align-items: center;
    }

    .hero-map {
      grid-column: auto;
    }
  }
</style>
