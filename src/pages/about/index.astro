---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'About Signal & Structure' }];
---

<Layout
  title="About Signal & Structure Coaching"
  description="Learn about Signal & Structure Coaching, a practical ADHD and executive-function coaching practice built around useful systems, experimentation, and real-life follow-through."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="About the practice"
    title="A coaching practice built around useful systems—not perfect routines."
    intro="Signal & Structure helps people make the invisible parts of planning, prioritizing, starting, and following through easier to see and work with."
    crumbs={crumbs}
  />

  <section class="definition">
    <div class="container definition-grid">
      <aside>
        <span>01</span>
        <p>WHAT “SIGNAL & STRUCTURE” MEANS</p>
      </aside>

      <div>
        <h2>Notice the signal. Build enough structure to act on it.</h2>

        <p>
          A missed deadline, abandoned planner, overloaded week, or pile of
          half-finished tasks contains information. The goal is not to turn
          every difficult moment into a character judgment. It is to notice
          where the system stopped supporting you.
        </p>

        <p>
          Structure then gives that information somewhere to go: a clearer
          next action, a visible reminder, a smaller starting point, a more
          realistic calendar, or a routine that can recover after disruption.
        </p>
      </div>
    </div>
  </section>

  <section class="operating-principles">
    <div class="container">
      <div class="principle-heading">
        <p class="eyebrow">How the practice operates</p>
        <h2>Four principles behind the work.</h2>
      </div>

      <ol>
        <li>
          <span>01</span>
          <h3>Make it visible</h3>
          <p>
            Get the task, decision, deadline, or competing demand out of your
            head so there is something concrete to work with.
          </p>
        </li>

        <li>
          <span>02</span>
          <h3>Make it usable</h3>
          <p>
            A system only matters if it still works when attention, energy,
            time, or motivation are less than ideal.
          </p>
        </li>

        <li>
          <span>03</span>
          <h3>Test it in real life</h3>
          <p>
            Coaching treats plans as experiments. What happens between
            sessions is useful information, not a pass-or-fail test.
          </p>
        </li>

        <li>
          <span>04</span>
          <h3>Build recovery in</h3>
          <p>
            Good systems need a way back in after travel, illness, a deadline
            crunch, a rough week, or a simple change of plans.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="scope">
    <div class="container scope-grid">
      <div>
        <p class="eyebrow">Practice scope</p>
        <h2>Clear about what coaching is—and what it is not.</h2>
      </div>

      <dl>
        <div><dt>Format</dt><dd>Individual virtual coaching</dd></div>
        <div><dt>Focus</dt><dd>ADHD & executive-function systems</dd></div>
        <div><dt>Clients</dt><dd>Adults, college students & professionals</dd></div>
        <div><dt>Location</dt><dd>Minneapolis-based, virtual coaching</dd></div>
        <div><dt>Not presented as</dt><dd>Therapy, diagnosis, or emergency support</dd></div>
      </dl>
    </div>
  </section>

  <section class="begin-map">
    <div class="container begin-grid">
      <div>
        <p class="eyebrow">Choose an entry point</p>
        <h2>Start with the friction or start with the process.</h2>
      </div>

      <div class="begin-links">
        <a href="/services/">
          <span>01 / COACHING</span>
          <strong>What keeps getting harder than it should?</strong>
          <p>
            Explore ADHD, executive-function, student, and professional
            coaching.
          </p>
          <b>Explore coaching options ↗</b>
        </a>

        <a href="/how-coaching-works/">
          <span>02 / PROCESS</span>
          <strong>What does coaching actually look like?</strong>
          <p>
            See how sessions move from observation to practical system design,
            real-life testing, and adjustment.
          </p>
          <b>See how coaching works ↗</b>
        </a>
      </div>
    </div>
  </section>

  <section class="coach-band">
    <div class="container coach-grid">
      <div class="identity-mark" aria-hidden="true">
        <span>AR</span>
        <div></div>
      </div>

      <div>
        <p class="eyebrow">The coach behind the structure</p>
        <h2>Meet Avery Reed.</h2>
        <p>
          Avery brings a practical, collaborative style to ADHD and
          executive-function coaching. The focus is on understanding where
          friction appears, designing supports that fit the client's actual
          life, and treating setbacks as information instead of failure.
        </p>

        <a href="/how-coaching-works/">See Avery's coaching process →</a>

        <p class="demo-disclosure">
          Portfolio note: Signal & Structure Coaching and Avery Reed are
          fictional. This website is a Brighter Sites design demonstration.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .definition,
  .operating-principles,
  .scope,
  .begin-map,
  .coach-band {
    padding: clamp(4rem,8vw,7rem) 0;
  }

  .definition-grid,
  .scope-grid,
  .begin-grid,
  .coach-grid {
    display: grid;
    gap: 2.5rem;
  }

  .definition aside {
    align-self: start;
    padding-top: .75rem;
    border-top: 3px solid #5f82ad;
  }

  .definition aside span {
    color: #5f82ad;
    font-size: 2.4rem;
    font-weight: 800;
  }

  .definition aside p {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .definition h2 {
    max-width: 27ch;
  }

  .definition-grid > div {
    max-width: 52rem;
  }

  .operating-principles {
    background: #edf4fb;
  }

  .principle-heading {
    max-width: 44rem;
  }

  .operating-principles ol {
    display: grid;
    gap: 1px;
    margin: 3rem 0 0;
    padding: 1px;
    background: #bfcfe0;
    list-style: none;
  }

  .operating-principles li {
    padding: 1.4rem;
    background: #f8fbff;
  }

  .operating-principles li span {
    color: #5f82ad;
    font-size: .7rem;
    font-weight: 800;
  }

  .operating-principles li h3 {
    margin-top: 2.25rem;
  }

  .scope {
    background: white;
  }

  .scope dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--sand);
  }

  .scope dl div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--sand);
  }

  .scope dt {
    color: #5f82ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .scope dd {
    margin: 0;
    color: var(--ink);
    font-weight: 700;
  }

  .begin-map {
    background: #f8fbff;
  }

  .begin-links {
    display: grid;
    gap: 1rem;
  }

  .begin-links a {
    display: grid;
    gap: .6rem;
    padding: 1.4rem;
    border: 1px solid var(--sand);
    background: white;
    color: var(--body);
    text-decoration: none;
  }

  .begin-links a:hover {
    border-color: #5f82ad;
    box-shadow: 0 16px 40px rgba(11,29,58,.08);
  }

  .begin-links span {
    color: #5f82ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .begin-links strong {
    color: var(--ink);
    font-size: 1.15rem;
  }

  .begin-links b {
    color: #3f648d;
    font-size: .8rem;
  }

  .coach-band {
    background: #0b1d3a;
    color: #dbe7f3;
  }

  .coach-band h2 {
    color: white;
  }

  .coach-band .eyebrow {
    color: #b5c8df;
  }

  .coach-band a {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .identity-mark {
    display: grid;
    width: 12rem;
    aspect-ratio: 1;
    place-content: center;
    border: 1px solid rgba(255,255,255,.28);
    color: white;
  }

  .identity-mark span {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -.08em;
  }

  .identity-mark div {
    width: 4rem;
    height: 3px;
    margin-top: .5rem;
    background: #a9bed6;
  }

  .demo-disclosure {
    max-width: 42rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255,255,255,.18);
    color: #91aac4;
    font-size: .75rem;
    line-height: 1.6;
  }

  @media (min-width:48rem) {
    .definition-grid {
      grid-template-columns: 12rem minmax(0,1fr);
      gap: clamp(3rem,7vw,8rem);
    }

    .operating-principles ol {
      grid-template-columns: repeat(4,1fr);
    }

    .scope-grid,
    .begin-grid,
    .coach-grid {
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(3rem,7vw,7rem);
    }

    .begin-links {
      grid-template-columns: repeat(2,1fr);
    }
  }
</style>
