---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/services';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Services' }];
const detailServices = services.filter(
  (service) => service.published && service.hasDetailPage
);
---

<Layout
  title="ADHD & Executive Function Coaching Services"
  description="Explore ADHD, executive-function, college student, and professional coaching with Signal & Structure Coaching."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="Coaching options"
    title="Start with the part of life that keeps creating friction."
    intro="You do not need to know exactly which kind of coaching you need. Choose the closest starting point, or bring the situation in your own words."
    crumbs={crumbs}
  />

  <section class="primary">
    <div class="container primary-grid">
      <div class="section-code">
        <span>01</span>
        <p>Coaching focus areas</p>
      </div>

      <div class="service-rows">
        {
          detailServices.map((service, index) => (
            <a href={service.href}>
              <b>{String(index + 1).padStart(2, '0')}</b>
              <div>
                <h2>{service.title}</h2>
                <p>{service.description}</p>
              </div>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="additional">
    <div class="container additional-grid">
      <div>
        <p class="eyebrow">Common friction points</p>
        <h2>The challenge often shows up in more than one part of life.</h2>
        <p>
          Coaching can focus on a single immediate problem while also building
          systems that transfer to school, work, home, routines, and longer-term
          projects.
        </p>
      </div>

      <div class="additional-list">
        <article>
          <h3>Task initiation</h3>
          <p>
            Reduce the distance between knowing something needs to happen and
            actually getting started.
          </p>
        </article>

        <article>
          <h3>Time awareness</h3>
          <p>
            Build clearer ways to estimate, plan, and notice time before the
            deadline becomes the organizing system.
          </p>
        </article>

        <article>
          <h3>Planning & prioritization</h3>
          <p>
            Turn a crowded list of obligations into a smaller set of visible
            decisions and next actions.
          </p>
        </article>

        <article>
          <h3>Follow-through</h3>
          <p>
            Create supports for the middle of a task or project—after the newness
            wears off but before the work is finished.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="service-guide">
    <div class="container guide-grid">
      <div>
        <p class="eyebrow">Focus versus process</p>
        <h2>What you want help with is different from how coaching works.</h2>
      </div>

      <div>
        <p>
          A coaching focus describes where the friction is showing up. The
          coaching process is how we make that friction visible, design a useful
          support, test it in real life, and adjust it over time.
        </p>

        <a href="/how-coaching-works/">See how coaching works →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .primary,
  .additional,
  .service-guide {
    padding: clamp(4rem,8vw,7rem) 0;
  }

  .primary-grid,
  .additional-grid,
  .guide-grid {
    display: grid;
    gap: 2.5rem;
  }

  .section-code {
    align-self: start;
    padding-top: .75rem;
    border-top: 3px solid #5f82ad;
  }

  .section-code span {
    color: #5f82ad;
    font-size: 2.4rem;
    font-weight: 800;
  }

  .section-code p {
    color: var(--muted);
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .service-rows {
    display: grid;
    border-top: 1px solid var(--sand);
  }

  .service-rows a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--sand);
    color: var(--body);
    text-decoration: none;
    transition: padding .18s ease,background .18s ease;
  }

  .service-rows a:hover {
    padding-inline: 1rem;
    background: #edf4fb;
  }

  .service-rows b {
    color: #5f82ad;
    font-size: .7rem;
  }

  .service-rows h2 {
    margin-bottom: .35rem;
    font-size: clamp(1.35rem,2vw,1.9rem);
  }

  .service-rows p {
    max-width: 48rem;
    font-size: .95rem;
  }

  .service-rows > a > span {
    color: #3f648d;
  }

  .additional {
    background: #edf4fb;
  }

  .additional-list {
    display: grid;
    gap: 1px;
    background: #bfcfe0;
  }

  .additional-list article {
    padding: 1.25rem;
    background: #f8fbff;
  }

  .additional-list h3 {
    font-size: 1rem;
  }

  .additional-list p {
    font-size: .92rem;
  }

  .service-guide {
    background: #0b1d3a;
    color: #dbe7f3;
  }

  .service-guide h2 {
    color: white;
  }

  .service-guide .eyebrow {
    color: #b5c8df;
  }

  .service-guide a {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  @media (min-width:48rem) {
    .primary-grid {
      grid-template-columns: 12rem minmax(0,1fr);
      gap: clamp(3rem,7vw,8rem);
    }

    .additional-grid,
    .guide-grid {
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(3rem,7vw,7rem);
    }

    .additional-list {
      grid-template-columns: repeat(2,1fr);
    }
  }
</style>
