---
import ServicePage from '../../components/ServicePage.astro';
import { services, type Service } from '../../data/services';
import { servicePages, type ServicePageContent } from '../../data/service-pages';

export function getStaticPaths() {
  return services
    .filter((service) =>
      service.published &&
      service.hasDetailPage &&
      typeof service.slug === 'string' &&
      service.slug.length > 0
    )
    .map((service) => ({
      params: { slug: service.slug },
      props: { service, content: servicePages[service.slug] },
    }));
}

interface Props { service: Service; content: ServicePageContent }
const { service, content } = Astro.props;
---
<ServicePage {service} {content} />
