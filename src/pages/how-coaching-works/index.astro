---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="How Coaching Works | Signal & Structure Coaching"
  description="Learn what to expect from ADHD and executive-function coaching with Signal & Structure Coaching."
>
  <PageHero
    eyebrow="The process"
    title="How coaching works"
    intro="A practical process for identifying friction, building useful systems, and adjusting them as real life changes."
    crumbs={[{ label: 'How Coaching Works' }]}
  />

  <section class="section">
    <div class="container measure">
      <h2>Observe. Design. Test. Adjust.</h2>
      <p>
        Coaching starts by making the problem visible. From there, we build
        practical supports, try them in real life, and adjust what does not fit.
      </p>
    </div>
  </section>
</Layout>
