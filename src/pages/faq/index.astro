---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="Coaching FAQ | Signal & Structure Coaching"
  description="Answers to common questions about ADHD coaching, executive-function coaching, sessions, packages, and getting started."
>
  <PageHero
    eyebrow="Questions"
    title="Frequently asked questions"
    intro="Straightforward answers about what coaching is, how sessions work, and whether Signal & Structure may be a good fit."
    crumbs={[{ label: 'FAQ' }]}
  />

  <section class="section">
    <div class="container measure">
      <h2>Questions before getting started are expected.</h2>
      <p>
        The full FAQ will cover coaching versus therapy, virtual sessions,
        packages, scheduling, and fit.
      </p>
    </div>
  </section>
</Layout>
