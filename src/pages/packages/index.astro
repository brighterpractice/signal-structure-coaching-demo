---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="Coaching Packages | Signal & Structure Coaching"
  description="Explore coaching package options for ADHD, executive-function, student, and professional coaching."
>
  <PageHero
    eyebrow="Ways to work together"
    title="Coaching packages"
    intro="Clear options for ongoing support, from focused short-term work to longer-term system building."
    crumbs={[{ label: 'Packages' }]}
  />

  <section class="section">
    <div class="container measure">
      <h2>Choose support that matches the work.</h2>
      <p>
        Package structure, session frequency, pricing, and discovery-call
        details will be developed in the next content pass.
      </p>
    </div>
  </section>
</Layout>
