---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { approaches, detailApproachSlugs } from '../../data/approaches';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Approaches' }];
const detailApproaches = approaches.filter((approach) =>
  detailApproachSlugs.has(approach.slug)
);
const overviewApproaches = approaches.filter(
  (approach) => !detailApproachSlugs.has(approach.slug)
);
---

<Layout
  title="Therapy Approaches in Madison, Wisconsin"
  description="A practical map of the therapy approaches Jordan Ellis may use, including IFS, Somatic Experiencing, attachment-focused work, and present-moment awareness."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="Method map"
    title="The method should clarify the work—not complicate it."
    intro="Jordan may use different frameworks to understand different parts of an experience. You can ask what a method means, why it is being considered, and what alternatives exist."
    crumbs={crumbs}
  />

  <section class="method-index">
    <div class="container index-grid">
      <div class="index-code">
        <span>01</span>
        <p>Detailed method notes</p>
      </div>

      <div class="featured-methods">
        {
          detailApproaches.map((approach, index) => (
            <a href={approach.href}>
              <div>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>DETAILED NOTE</p>
              </div>
              <h2>{approach.title}</h2>
              <p>{approach.cardDescription}</p>
              <b>Open method note ↗</b>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="other-methods" id="other-methods">
    <div class="container other-grid">
      <div>
        <p class="eyebrow">Integrated as useful</p>
        <h2>Other ways Jordan may organize the conversation.</h2>
      </div>

      <div class="other-list">
        {
          overviewApproaches.map((approach, index) => (
            <article>
              <span>{String(index + 3).padStart(2, '0')}</span>
              <div>
                <h3>{approach.title}</h3>
                <p>{approach.cardDescription}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="method-principle">
    <div class="container principle-grid">
      <div>
        <p class="eyebrow">One operating principle</p>
        <h2>The framework serves the person.</h2>
      </div>

      <div>
        <p>
          A therapy method is not a personality test or a predetermined route.
          The approach can change as the concern becomes clearer, and you can
          say when language, pacing, or an exercise does not fit.
        </p>
        <a href="/about/jordan-ellis/">Read how Jordan works →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .method-index,
  .other-methods,
  .method-principle {
    padding: clamp(4rem,8vw,7rem) 0;
  }

  .index-grid,
  .other-grid,
  .principle-grid {
    display: grid;
    gap: 2.5rem;
  }

  .index-code {
    align-self: start;
    padding-top: .75rem;
    border-top: 3px solid #5f82ad;
  }

  .index-code span {
    color: #5f82ad;
    font-size: 2.4rem;
    font-weight: 800;
  }

  .index-code p {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .featured-methods {
    display: grid;
    gap: 1rem;
  }

  .featured-methods a {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--sand);
    background: white;
    color: var(--body);
    text-decoration: none;
  }

  .featured-methods a:hover {
    border-color: #5f82ad;
    box-shadow: 0 16px 40px rgba(11,29,58,.09);
  }

  .featured-methods a > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #5f82ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
  }

  .featured-methods h2 {
    margin: 1.5rem 0 0;
  }

  .featured-methods b {
    color: #3f648d;
    font-size: .82rem;
  }

  .other-methods {
    background: #edf4fb;
  }

  .other-list {
    display: grid;
    border-top: 1px solid #bfcfe0;
  }

  .other-list article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #bfcfe0;
  }

  .other-list span {
    color: #5f82ad;
    font-size: .7rem;
    font-weight: 800;
  }

  .other-list h3 {
    margin-bottom: .35rem;
  }

  .method-principle {
    background: #0b1d3a;
    color: #dbe7f3;
  }

  .method-principle h2 {
    color: white;
  }

  .method-principle .eyebrow {
    color: #b5c8df;
  }

  .method-principle a {
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  @media (min-width:48rem) {
    .index-grid {
      grid-template-columns: 12rem minmax(0,1fr);
      gap: clamp(3rem,7vw,8rem);
    }

    .featured-methods {
      grid-template-columns: repeat(2,1fr);
    }

    .other-grid,
    .principle-grid {
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(3rem,7vw,7rem);
    }
  }
</style>
