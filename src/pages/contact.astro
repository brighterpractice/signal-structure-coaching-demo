---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import {
  appointmentUrl,
  practice,
} from '../data/site';
import { breadcrumbSchema, pageSchema } from '../lib/schema';

const crumbs = [{ label: 'Contact' }];
---

<Layout
  title="Contact Signal & Structure Coaching"
  description="Book a discovery call with Signal & Structure Coaching to discuss ADHD, executive-function, student, or professional coaching."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="Start here"
    title="Begin with the problem you are actually trying to solve."
    intro="A discovery call is a simple first conversation about what feels difficult, what you have already tried, and whether coaching may be useful."
    crumbs={crumbs}
  />

  <section class="contact-start" id="new-clients">
    <div class="container start-grid">
      <aside>
        <span>01</span>
        <p>DISCOVERY CALL</p>
      </aside>

      <div class="start-copy">
        <p class="eyebrow">Start with fit</p>
        <h2>You do not need to prepare a perfect explanation.</h2>

        <p>
          Bring the part that keeps creating friction: missed deadlines,
          overloaded weeks, abandoned systems, difficulty starting, competing
          priorities, or the sense that keeping everything organized requires
          more effort than it should.
        </p>

        <div class="privacy-line">
          <strong>A simple first message is enough.</strong>
          <span>
            Your name, contact information, general scheduling availability,
            and a short description of what you would like help with are plenty
            for the first step.
          </span>
        </div>

        <Button href={appointmentUrl} tracking="request-appointment">
          Book a discovery call
        </Button>
      </div>
    </div>
  </section>

  <section class="steps">
    <div class="container">
      <p class="eyebrow">What happens next</p>
      <h2>A straightforward path from first contact to coaching.</h2>

      <ol>
        <li>
          <span>01</span>
          <h3>Connect</h3>
          <p>
            Share basic contact information and what you would like to work on.
          </p>
        </li>

        <li>
          <span>02</span>
          <h3>Talk</h3>
          <p>
            Use the discovery call to discuss fit, goals, scheduling, and which
            coaching option makes the most sense.
          </p>
        </li>

        <li>
          <span>03</span>
          <h3>Build</h3>
          <p>
            Begin with one real friction point and start designing a system you
            can test in everyday life.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="contact-reference">
    <div class="container reference-grid">
      <div>
        <p class="eyebrow">Practice reference</p>
        <h2>{practice.name}</h2>
      </div>

      <dl>
        <div>
          <dt>Format</dt>
          <dd>Individual virtual coaching</dd>
        </div>

        <div>
          <dt>Focus</dt>
          <dd>ADHD & executive-function coaching</dd>
        </div>

        <div>
          <dt>Clients</dt>
          <dd>Adults, college students & professionals</dd>
        </div>

        <div>
          <dt>Based in</dt>
          <dd>{practice.city}, {practice.state}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="safety">
    <div class="container safety-grid">
      <div>
        <p class="eyebrow">Scope of coaching</p>
        <h2>Coaching is not therapy or emergency support.</h2>
      </div>

      <p>
        Signal & Structure provides coaching focused on planning, organization,
        attention, routines, and follow-through. It does not diagnose or treat
        mental-health conditions and is not an emergency or crisis service. If
        you need urgent help or are in immediate danger, contact the appropriate
        local emergency or crisis resource.
      </p>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container faq-grid">
      <div>
        <p class="eyebrow">Before you book</p>
        <h2>Three useful answers.</h2>
      </div>

      <div>
        <details>
          <summary>Do I need an ADHD diagnosis?</summary>
          <p>
            No. Coaching can focus on executive-function challenges and practical
            systems whether or not you have a formal ADHD diagnosis.
          </p>
        </details>

        <details>
          <summary>Is coaching the same as therapy?</summary>
          <p>
            No. Coaching is future-focused and practical, with an emphasis on
            goals, systems, skills, experimentation, and follow-through. It is
            not mental-health treatment.
          </p>
        </details>

        <details>
          <summary>Where do sessions take place?</summary>
          <p>
            This fictional demonstration presents Signal & Structure as a
            Minneapolis-based practice providing individual virtual coaching.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-start,
  .steps,
  .contact-reference,
  .safety,
  .faq {
    padding: clamp(4rem,8vw,7rem) 0;
  }

  .start-grid,
  .reference-grid,
  .safety-grid,
  .faq-grid {
    display: grid;
    gap: 2.5rem;
  }

  .start-grid > aside {
    align-self: start;
    padding-top: .75rem;
    border-top: 3px solid #5f82ad;
  }

  .start-grid > aside span {
    color: #5f82ad;
    font-size: 2.4rem;
    font-weight: 800;
  }

  .start-grid > aside p {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
  }

  .start-copy {
    max-width: 50rem;
  }

  .privacy-line {
    display: grid;
    gap: .35rem;
    margin: 1.75rem 0;
    padding: 1.2rem;
    border-left: 4px solid #5f82ad;
    background: #edf4fb;
  }

  .privacy-line strong {
    color: var(--ink);
  }

  .steps {
    background: #edf4fb;
  }

  .steps > .container > h2 {
    max-width: 28ch;
  }

  .steps ol {
    display: grid;
    gap: 1px;
    margin: 3rem 0 0;
    padding: 1px;
    background: #bfcfe0;
    list-style: none;
  }

  .steps li {
    padding: 1.4rem;
    background: #f8fbff;
  }

  .steps li span {
    color: #5f82ad;
    font-size: .7rem;
    font-weight: 800;
  }

  .steps li h3 {
    margin-top: 2rem;
  }

  .contact-reference dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--sand);
  }

  .contact-reference dl div {
    padding: 1rem 0;
    border-bottom: 1px solid var(--sand);
  }

  .contact-reference dt {
    color: #5f82ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .contact-reference dd {
    margin: .3rem 0 0;
    color: var(--ink);
    font-weight: 700;
  }

  .contact-reference a {
    color: #3f648d;
    text-decoration: none;
  }

  .safety {
    background: #0b1d3a;
    color: #dbe7f3;
  }

  .safety h2 {
    color: white;
  }

  .safety .eyebrow {
    color: #b5c8df;
  }

  .faq details {
    padding: 1.15rem 0;
    border-top: 1px solid var(--sand);
  }

  .faq details:last-child {
    border-bottom: 1px solid var(--sand);
  }

  .faq summary {
    cursor: pointer;
    color: var(--ink);
    font-weight: 750;
  }

  .faq details p {
    padding-top: .85rem;
  }

  @media (min-width:48rem) {
    .start-grid {
      grid-template-columns: 12rem minmax(0,1fr);
      gap: clamp(3rem,7vw,8rem);
    }

    .steps ol {
      grid-template-columns: repeat(3,1fr);
    }

    .reference-grid,
    .safety-grid,
    .faq-grid {
      grid-template-columns: .8fr 1.2fr;
      gap: clamp(3rem,7vw,7rem);
    }
  }
</style>
