---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Page Not Found | Signal & Structure Coaching"
  description="The requested page could not be found on the Signal & Structure Coaching website."
  noindex
>
  <PageHero
    eyebrow="Page not found"
    title="That page is not part of the plan."
    intro="The address may have changed, or the page may no longer be available."
  />

  <section class="section">
    <div class="container not-found-links" aria-label="Helpful pages">
      <a class="button" href="/">Return home</a>
      <a class="button button--outline" href="/services/">Explore coaching</a>
      <a class="link-arrow" href="/contact/">Contact Signal & Structure</a>
    </div>
  </section>
</Layout>

<style>
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .not-found-links .link-arrow {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
</style>
