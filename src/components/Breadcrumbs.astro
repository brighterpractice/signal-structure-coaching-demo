---
interface Props {items:{label:string;href?:string}[]} const {items}=Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{items.map((item,i)=><li>{item.href&&i<items.length-1?<a href={item.href}>{item.label}</a>:<span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
<style>.breadcrumbs ol{display:flex;flex-wrap:wrap;gap:.45rem;margin:0 0 1.5rem;padding:0;list-style:none;font-size:.78rem}.breadcrumbs li+li:before{content:"/";margin-right:.45rem;color:var(--sage)}.breadcrumbs a{text-decoration:none}</style>
