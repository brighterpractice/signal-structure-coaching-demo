---
import { practice } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <div class="footer-mark" aria-hidden="true">S&amp;S</div>

      <div>
        <p class="name">{practice.name}</p>
        <p>{practice.serviceLine}</p>
        <span>{practice.city}, {practice.state}</span>
      </div>
    </div>

    <div class="footer-nav">
      <p class="footer-label">Navigate</p>
      <a href="/about/">Practice profile</a>
      <a href="/services/">Focus map</a>
      <a href="/how-coaching-works/">How coaching works</a>
      <a href="/contact/">Start here</a>
    </div>

    <div class="footer-demo">
      <p class="footer-label">Design demonstration</p>
      <p>
        Signal &amp; Structure Coaching is fictional. This site demonstrates
        a modern ADHD and executive-function coaching direction created by
        Brighter Sites.
      </p>
      <a
        href="https://brightersites.app/work/"
        target="_blank"
        rel="noopener noreferrer"
      >
        View Brighter Sites work ↗
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {practice.name}</span>

    <span class="legal-links">
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </span>

    <span class="signature">
      Built and managed by{" "}
      <a
        href="https://brightersites.app"
        target="_blank"
        rel="noopener noreferrer"
      >
        Brighter Sites
      </a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 4.5rem 0 2rem;
    border-top: .45rem solid var(--signal);
    background:
      linear-gradient(
        rgba(200,244,77,.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(200,244,77,.025) 1px,
        transparent 1px
      ),
      #151a21;
    background-size: 2.5rem 2.5rem;
    color: #aeb6c0;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }

  .footer-identity {
    display: flex;
    gap: 1rem;
    align-items: start;
  }

  .footer-mark {
    display: grid;
    width: 3.35rem;
    aspect-ratio: 1;
    place-items: center;
    border: 0;
    border-radius: .2rem;
    background: var(--signal);
    color: var(--ink);
    font-size: .7rem;
    font-weight: 950;
    letter-spacing: .08em;
    box-shadow: 4px 4px 0 var(--structure);
  }

  .name {
    margin: 0;
    color: white;
    font-size: 1.15rem;
    font-weight: 820;
    letter-spacing: -.025em;
  }

  .footer-identity p:not(.name) {
    margin: .3rem 0 0;
    color: #d2d6dc;
    font-size: .8rem;
  }

  .footer-identity span {
    color: #7f8995;
    font-size: .73rem;
  }

  .footer-label {
    margin: 0 0 .8rem;
    color: var(--signal);
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .footer-nav {
    display: grid;
    align-content: start;
  }

  .footer-nav a,
  .footer-demo a {
    display: flex;
    width: fit-content;
    min-height: 40px;
    align-items: center;
    color: #e9ecf0;
    font-size: .82rem;
    font-weight: 680;
    text-decoration: none;
  }

  .footer-nav a:hover,
  .footer-demo a:hover {
    color: var(--signal);
  }

  .footer-demo p:not(.footer-label) {
    max-width: 30rem;
    font-size: .8rem;
    line-height: 1.65;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem 1.25rem;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.3rem;
    border-top: 1px solid #343b45;
    color: #77818d;
    font-size: .68rem;
  }

  .legal-links {
    display: flex;
    gap: 1rem;
  }

  .footer-bottom a {
    color: #aeb6c0;
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--signal);
  }

  .signature a {
    font-weight: 760;
  }

  @media (min-width:48rem) {
    .footer-grid {
      grid-template-columns: 1.15fr .65fr 1fr;
      gap: clamp(2.5rem,5vw,5rem);
    }

    .footer-nav a,
    .footer-demo a {
      min-height: 0;
      padding: .28rem 0;
    }
  }
</style>
