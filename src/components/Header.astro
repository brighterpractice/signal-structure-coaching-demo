---
import Button from './Button.astro';
import { navigation } from '../data/navigation';
import {
  appointmentUrl,
  clientPortalUrl,
  externalLinkAttrs,
} from '../data/site';

const path = Astro.url.pathname;
const portalAttrs = externalLinkAttrs();
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container mobile-header">
    <a class="mobile-brand" href="/" aria-label="Align Therapy Group home">
      <img
        src="/images/branding/align-wordmark.png"
        width="360"
        height="101"
        alt=""
        fetchpriority="high"
      />
    </a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav aria-label="Mobile navigation" data-track="mobile-navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>
          Home
        </a>

        {
          navigation.map((item) => (
            <div class="mobile-group">
              <a
                class="mobile-parent"
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>

              {
                item.children.slice(1).map((child) => (
                  <a
                    href={child.href}
                    aria-current={path === child.href ? 'page' : undefined}
                  >
                    {child.label}
                  </a>
                ))
              }
            </div>
          ))
        }

        <a
          href={clientPortalUrl}
          target={portalAttrs.target}
          rel={portalAttrs.rel}
          data-track="client-portal"
        >
          Client Portal
        </a>
      </nav>
    </details>
  </div>

  <aside class="desktop-rail" aria-label="Site navigation">
    <div class="rail-brand">
      <a href="/" aria-label="Align Therapy Group home">
        <img
          src="/images/branding/align-wordmark.png"
          width="360"
          height="101"
          alt=""
          fetchpriority="high"
        />
      </a>

      <p>Individual counseling for adults</p>
      <span>Madison, Wisconsin</span>
    </div>

    <nav class="rail-nav" aria-label="Primary navigation" data-track="primary-navigation">
      <a
        class:list={['rail-home', { active: path === '/' }]}
        href="/"
        aria-current={path === '/' ? 'page' : undefined}
      >
        <span>01</span>
        Home
      </a>

      {
        navigation.map((item, index) => (
          <section class:list={['rail-group', { active: isCurrent(item.href) }]}>
            <a
              class="rail-parent"
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              <span>{String(index + 2).padStart(2, '0')}</span>
              {item.label}
            </a>

            {
              item.children.length > 1 && (
                <div class="rail-children">
                  {item.children.slice(1).map((child) => (
                    <a
                      href={child.href}
                      aria-current={path === child.href ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )
            }
          </section>
        ))
      }
    </nav>

    <div class="rail-actions">
      <Button href={appointmentUrl} tracking="request-appointment">
        Request appointment
      </Button>

      <a
        class="rail-portal"
        href={clientPortalUrl}
        target={portalAttrs.target}
        rel={portalAttrs.rel}
        data-track="client-portal"
      >
        Current clients
        <span>Client Portal ↗</span>
      </a>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(112,135,125,.2);
    background: rgba(255,253,249,.95);
    backdrop-filter: blur(14px);
  }

  .mobile-header {
    display: flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-brand {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
  }

  .mobile-brand img {
    display: block;
    width: 9.3rem;
    height: auto;
  }

  .mobile-nav {
    flex: 0 0 auto;
  }

  .mobile-nav > summary {
    display: grid;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    list-style: none;
    place-content: center;
    gap: 5px;
  }

  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav > summary span {
    width: 1.45rem;
    height: 2px;
    background: var(--ink);
    transition: transform .2s ease, opacity .2s ease;
  }

  .mobile-nav[open] > summary span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-nav[open] > summary span:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav[open] > summary span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav nav {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-width: 100vw;
    max-height: calc(100dvh - 4.8rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    border-bottom: 1px solid var(--sand);
    background: var(--paper);
  }

  .mobile-nav a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding: .45rem .3rem;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--clay-text);
  }

  .mobile-group {
    padding-block: .3rem;
    border-top: 1px solid var(--sand);
  }

  .mobile-group a:not(.mobile-parent) {
    padding-left: 1.25rem;
    color: var(--body);
    font-size: .93rem;
    font-weight: 500;
  }

  .desktop-rail {
    display: none;
  }

  @media (min-width:64rem) {
    .site-header {
      position: static;
      border: 0;
      background: transparent;
      backdrop-filter: none;
    }

    .mobile-header {
      display: none;
    }

    .desktop-rail {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 60;
      display: flex;
      width: 18rem;
      overflow-y: auto;
      flex-direction: column;
      padding: 2rem 1.5rem 1.5rem;
      border-right: 1px solid #cfdded;
      background:
        linear-gradient(180deg, #f8fbff 0%, #edf4fb 100%);
      box-shadow: 12px 0 40px rgba(11,29,58,.04);
    }

    .rail-brand {
      padding: .25rem .35rem 1.65rem;
      border-bottom: 1px solid #cfdded;
    }

    .rail-brand a {
      display: block;
      width: fit-content;
    }

    .rail-brand img {
      display: block;
      width: 11.75rem;
      height: auto;
    }

    .rail-brand p {
      margin: 1.15rem 0 .1rem;
      color: var(--ink);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .04em;
    }

    .rail-brand span {
      color: var(--muted);
      font-size: .76rem;
    }

    .rail-nav {
      display: grid;
      gap: .15rem;
      padding: 1.35rem 0;
    }

    .rail-home,
    .rail-parent {
      display: grid;
      grid-template-columns: 2.1rem 1fr;
      align-items: center;
      min-height: 2.65rem;
      padding: .5rem .65rem;
      border-left: 3px solid transparent;
      color: var(--ink);
      font-size: .88rem;
      font-weight: 800;
      text-decoration: none;
      transition:
        background-color .18s ease,
        border-color .18s ease,
        color .18s ease,
        box-shadow .18s ease,
        transform .18s ease;
    }

    .rail-home > span,
    .rail-parent > span {
      color: #7692b2;
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .08em;
    }

    .rail-home:hover,
    .rail-parent:hover,
    .rail-home.active,
    .rail-group.active > .rail-parent {
      border-left-color: #3f648d;
      background: #dce9f7;
      color: #173b63;
      box-shadow: 0 8px 18px rgba(11,29,58,.08);
      transform: translateX(3px);
    }

    .rail-group {
      margin: 0;
    }

    .rail-children {
      display: grid;
      gap: .1rem;
      padding: .1rem .5rem .55rem 2.75rem;
    }

    .rail-children a {
      padding: .32rem 0;
      color: var(--muted);
      font-size: .74rem;
      border-radius: .35rem;
      font-weight: 600;
      line-height: 1.35;
      text-decoration: none;
      transition:
        background-color .18s ease,
        color .18s ease,
        padding .18s ease;
    }

    .rail-children a:hover,
    .rail-children a[aria-current="page"] {
      padding-left: .5rem;
      background: #dce9f7;
      color: #173b63;
    }

    .rail-actions {
      display: grid;
      gap: 1rem;
      margin-top: auto;
      padding: 1.25rem .35rem 0;
      border-top: 1px solid #cfdded;
    }

    .rail-actions :global(.button) {
      width: 100%;
    }

    .rail-portal {
      display: grid;
      gap: .1rem;
      color: var(--muted);
      font-size: .68rem;
      font-weight: 700;
      text-decoration: none;
    }

    .rail-portal span {
      color: var(--ink);
      font-size: .8rem;
      font-weight: 800;
    }
  }
</style>
