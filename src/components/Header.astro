---
import Button from './Button.astro';
import { navigation } from '../data/navigation';
import {
  appointmentUrl,
  practice,
} from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container mobile-header">
    <a class="mobile-brand" href="/" aria-label={`${practice.name} home`}>
      <span class="brand-lockup">
        <strong>{practice.shortName}</strong>
        <small>COACHING</small>
      </span>
    </a>

    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <nav aria-label="Mobile navigation" data-track="mobile-navigation">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>
          Home
        </a>

        {
          navigation.map((item) => (
            <div class="mobile-group">
              <a
                class="mobile-parent"
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>

              {
                item.children.slice(1).map((child) => (
                  <a
                    href={child.href}
                    aria-current={path === child.href ? 'page' : undefined}
                  >
                    {child.label}
                  </a>
                ))
              }
            </div>
          ))
        }
      </nav>
    </details>
  </div>

  <aside class="desktop-rail" aria-label="Site navigation">
    <div class="rail-brand">
      <a href="/" aria-label={`${practice.name} home`}>
        <span class="brand-lockup">
          <strong>{practice.shortName}</strong>
          <small>COACHING</small>
        </span>
      </a>

      <p>{practice.serviceLine}</p>
      <span>{practice.city}, {practice.state}</span>
    </div>

    <nav class="rail-nav" aria-label="Primary navigation" data-track="primary-navigation">
      <a
        class:list={['rail-home', { active: path === '/' }]}
        href="/"
        aria-current={path === '/' ? 'page' : undefined}
      >
        <span>01</span>
        Home
      </a>

      {
        navigation.map((item, index) => (
          <section class:list={['rail-group', { active: isCurrent(item.href) }]}>
            <a
              class="rail-parent"
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              <span>{String(index + 2).padStart(2, '0')}</span>
              {item.label}
            </a>

            {
              item.children.length > 1 && (
                <div class="rail-children">
                  {item.children.slice(1).map((child) => (
                    <a
                      href={child.href}
                      aria-current={path === child.href ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )
            }
          </section>
        ))
      }
    </nav>

    <div class="rail-actions">
      <Button href={appointmentUrl} tracking="request-appointment">
        Book a discovery call
      </Button>
    </div>
  </aside>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #2b323c;
    background: rgba(20,25,32,.98);
  }

  .mobile-header {
    display: flex;
    min-height: 4.65rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-brand {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
  }

  .brand-lockup {
    display: grid;
    gap: .3rem;
    color: white;
    line-height: 1;
  }

  .brand-lockup strong {
    font-size: 1.03rem;
    font-weight: 820;
    letter-spacing: -.03em;
  }

  .brand-lockup small {
    color: var(--signal);
    font-size: .56rem;
    font-weight: 900;
    letter-spacing: .22em;
  }

  .mobile-brand,
  .rail-brand a {
    text-decoration: none;
  }

  .mobile-nav {
    flex: 0 0 auto;
  }

  .mobile-nav > summary {
    display: grid;
    width: 3rem;
    height: 3rem;
    cursor: pointer;
    list-style: none;
    place-content: center;
    gap: 5px;
    border: 1px solid #39414d;
    background: #1b212a;
  }

  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav > summary span {
    width: 1.4rem;
    height: 2px;
    background: var(--signal);
    transition:
      transform .2s ease,
      opacity .2s ease;
  }

  .mobile-nav[open] > summary span:first-child {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-nav[open] > summary span:nth-child(2) {
    opacity: 0;
  }

  .mobile-nav[open] > summary span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav nav {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-width: 100vw;
    max-height: calc(100dvh - 4.65rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    border-bottom: 1px solid #343b45;
    background: #151a21;
  }

  .mobile-nav a {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding: .45rem .3rem;
    color: #f1f3f5;
    font-weight: 760;
    text-decoration: none;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--signal);
  }

  .mobile-group {
    padding-block: .3rem;
    border-top: 1px solid #343b45;
  }

  .mobile-group a:not(.mobile-parent) {
    padding-left: 1.25rem;
    color: #aeb6c0;
    font-size: .91rem;
    font-weight: 550;
  }

  .desktop-rail {
    display: none;
  }

  @media (min-width:64rem) {
    .site-header {
      position: static;
      border: 0;
      background: transparent;
    }

    .mobile-header {
      display: none;
    }

    .desktop-rail {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 60;
      display: flex;
      width: 18rem;
      overflow-y: auto;
      flex-direction: column;
      padding: 1.8rem 1.35rem 1.4rem;
      border-right: 1px solid #303640;
      background:
        linear-gradient(
          rgba(200,244,77,.035) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(200,244,77,.035) 1px,
          transparent 1px
        ),
        #151a21;
      background-size: 2rem 2rem;
      box-shadow: 12px 0 36px rgba(21,26,33,.12);
    }

    .rail-brand {
      position: relative;
      padding: .25rem .5rem 1.65rem;
      border-bottom: 1px solid #353c46;
    }

    .rail-brand:after {
      content: "";
      position: absolute;
      right: .5rem;
      bottom: -2px;
      width: 3.5rem;
      height: 3px;
      background: var(--signal);
    }

    .rail-brand a {
      display: block;
      width: fit-content;
    }

    .rail-brand .brand-lockup strong {
      color: white;
      font-size: 1.15rem;
    }

    .rail-brand p {
      margin: 1.1rem 0 .12rem;
      color: #edf0f4;
      font-size: .76rem;
      font-weight: 760;
      line-height: 1.45;
    }

    .rail-brand > span {
      color: #8f98a4;
      font-size: .73rem;
    }

    .rail-nav {
      display: grid;
      gap: .08rem;
      padding: 1.3rem 0;
    }

    .rail-home,
    .rail-parent {
      display: grid;
      grid-template-columns: 2.1rem 1fr;
      align-items: center;
      min-height: 2.65rem;
      padding: .5rem .6rem;
      border-left: 3px solid transparent;
      color: #e7eaee;
      font-size: .86rem;
      font-weight: 780;
      text-decoration: none;
      transition:
        background-color .16s ease,
        border-color .16s ease,
        color .16s ease,
        transform .16s ease;
    }

    .rail-home > span,
    .rail-parent > span {
      color: var(--signal);
      font-size: .62rem;
      font-weight: 900;
      letter-spacing: .1em;
    }

    .rail-home:hover,
    .rail-parent:hover,
    .rail-home.active,
    .rail-group.active > .rail-parent {
      border-left-color: var(--signal);
      background: rgba(200,244,77,.09);
      color: white;
      transform: translateX(3px);
    }

    .rail-group {
      margin: 0;
    }

    .rail-children {
      display: grid;
      gap: .08rem;
      padding: .1rem .45rem .55rem 2.75rem;
    }

    .rail-children a {
      padding: .33rem .2rem;
      color: #919aa5;
      font-size: .72rem;
      font-weight: 600;
      line-height: 1.35;
      text-decoration: none;
      transition:
        color .16s ease,
        padding .16s ease;
    }

    .rail-children a:hover,
    .rail-children a[aria-current="page"] {
      padding-left: .55rem;
      color: var(--signal);
    }

    .rail-actions {
      display: grid;
      gap: 1rem;
      margin-top: auto;
      padding: 1.25rem .45rem 0;
      border-top: 1px solid #353c46;
    }

    .rail-actions :global(.button) {
      width: 100%;
    }
  }
</style>
