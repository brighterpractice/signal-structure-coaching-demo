---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  crumbs?: { label: string; href?: string }[];
}

const { eyebrow, title, intro, crumbs } = Astro.props;
---

<section class="page-hero">
  <div class="hero-accent" aria-hidden="true"></div>

  <div class="container page-hero-grid">
    <div class="hero-meta">
      {crumbs && <Breadcrumbs items={crumbs} />}

      {eyebrow && (
        <div class="hero-label">
          <span></span>
          <p>{eyebrow}</p>
        </div>
      )}
    </div>

    <div class="hero-main">
      <h1>{title}</h1>

      <div class="intro-wrap">
        <span class="intro-rule" aria-hidden="true"></span>
        <p class="intro">{intro}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.75rem,8vw,7rem) 0;
    border-bottom: 1px solid #d8dbd3;
    background:
      linear-gradient(
        rgba(70,87,242,.055) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(70,87,242,.055) 1px,
        transparent 1px
      ),
      #f3f3ee;
    background-size: 3rem 3rem;
  }

  .hero-accent {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(5rem,14vw,11rem);
    height: 100%;
    background: var(--structure);
  }

  .hero-accent:before {
    content: "";
    position: absolute;
    top: 16%;
    left: -2rem;
    width: 4rem;
    height: 4rem;
    background: var(--signal);
  }

  .hero-accent:after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 11%;
    width: 70%;
    height: 1rem;
    background: #151a21;
  }

  .page-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.25rem;
    padding-right: clamp(2rem,8vw,6rem);
  }

  .hero-meta {
    align-self: start;
  }

  .hero-label {
    display: flex;
    gap: .75rem;
    align-items: center;
    margin-top: 1.2rem;
  }

  .hero-label span {
    display: block;
    width: .8rem;
    height: .8rem;
    background: var(--signal-strong);
  }

  .hero-label p {
    margin: 0;
    color: #4e5d00;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .hero-main h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.7rem,6vw,5.2rem);
    line-height: .94;
  }

  .intro-wrap {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: 1.15rem;
    max-width: 46rem;
    margin-top: 2rem;
  }

  .intro-rule {
    background: var(--structure);
  }

  .intro {
    margin: 0;
    color: #4f5863;
    font-size: clamp(1.05rem,1.8vw,1.3rem);
    line-height: 1.62;
  }

  @media (min-width:48rem) {
    .page-hero-grid {
      grid-template-columns: minmax(11rem,.3fr) minmax(0,1fr);
      gap: clamp(3rem,7vw,7rem);
      align-items: start;
    }
  }
</style>
