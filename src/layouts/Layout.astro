---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { appointmentUrl, practice } from '../data/site';
import '../styles/global.css';

interface Props {
 title: string;
 description: string;
 image?: string;
 schema?: Record<string, unknown>;
 noindex?: boolean;
}

const {
 title,
 description,
 image,
 schema,
 noindex = false,
} = Astro.props;
const siteName = practice.name;
const pageTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const base = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, base);
const socialImage = image ? new URL(image, base) : null;

const analyticsSiteKey =
  import.meta.env.PUBLIC_BRIGHTER_ANALYTICS_SITE_KEY?.trim();

const analyticsConfig = analyticsSiteKey
  ? JSON.stringify({
      collectorUrl: 'https://analytics.brightersites.app',
      siteKey: analyticsSiteKey,
      scriptVersion: '2.0.0',
    })
  : null;
---
<!doctype html>
<html lang="en" data-bs-analytics-page={noindex ? "404" : undefined}>
 <head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1" />
 <meta name="generator" content={Astro.generator} />
 <title>{pageTitle}</title>
 <meta name="description" content={description} />
 <meta name="robots" content={noindex ? "noindex, nofollow" : "noindex, follow"} />
 {!noindex && <link rel="canonical" href={canonical} />}
 <meta property="og:type" content="website" />
 <meta property="og:site_name" content={siteName} />
 <meta property="og:title" content={pageTitle} />
 <meta property="og:description" content={description} />
 {!noindex && <meta property="og:url" content={canonical} />}
 {socialImage && <meta property="og:image" content={socialImage} />}
 {socialImage && <meta property="og:image:width" content="1200" />}
 {socialImage && <meta property="og:image:height" content="630" />}
 {socialImage && <meta property="og:image:alt" content="Signal & Structure Coaching" />}
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:title" content={pageTitle} />
 <meta name="twitter:description" content={description} />
 {socialImage && <meta name="twitter:image" content={socialImage} />}
 {socialImage && <meta name="twitter:image:alt" content="Signal & Structure Coaching" />}
 <meta name="theme-color" content="#151a21" />
 <link rel="icon" type="image/svg+xml" href="/images/branding/signal-structure-mark.svg" />
 {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
 </head>
 <body>
 <a class="skip-link" href="#main-content">Skip to main content</a>
 <Header />
 <main id="main-content"><slot /></main>
 <Footer />
 <Button id="mobile-appointment" href={appointmentUrl} tracking="request-appointment">Book a discovery call</Button>
 <script is:inline src="/scripts/site.js?v=6"></script>

  {
    analyticsConfig && (
      <>
        <script
          is:inline
          type="application/json"
          data-bs-analytics-config
          set:html={analyticsConfig}
        ></script>
        <script
          is:inline
          src="/brighter-analytics.js?v=2.0.0"
          defer
        ></script>
      </>
    )
  }
 </body>
</html>
